    },
    {
      "name": "policy_violations.json",
      "path": "reference/policy_violations.json",
      "format": "JSON",
      "bytes": 156094,
      "description": "字段级违规、政策条款、严重性与汇总。"
    }
  ],
  "evaluation": {
    "method": "评分器读取交付文件，逐项计算 0～1 的得分，再按权重求加权平均。网站以 100 分制展示结果。",
    "criteria": [
      {
        "name": "字段违规",
        "weight": 65,
        "rule": "按动作 ID 与字段名比对违规记录、条款和严重性，按正确比例计分。"
      },
      {
        "name": "违规汇总",
        "weight": 10,
        "rule": "比对违规总数和严重性分布，按字段正确比例计分。"
      },
      {
        "name": "业务域暴露",
        "weight": 25,
        "rule": "按业务域比较聚合人数、数据类型数量和放大率，按正确比例计分。"
      }
    ],
    "notes": "",
    "scoreRange": [
      0,
      100
    ],
    "type": "deterministic",
    "entrypoint": "tests/test.sh",
    "verifierMode": "separate",
    "formula": "reward = Σ(weight × check_score) / Σ(weight)；网站得分 = 100 × reward",
    "process": [
      "按 action_id 与 data_field_name 对齐字段级违规记录。",
      "核对条款、严重程度及严重性汇总。",
      "按域核对跨域暴露数量与放大率。"
    ],
    "metrics": [
      "字段级违规与条款占 65%；严重性汇总占 10%；跨域报告占 25%。",
      "违规记录使用联合主键，跨域记录使用 domain；重复主键使相应项记 0。"
    ],
    "gates": [],
    "checks": [
      {
        "name": "字段级违规与条款",
        "weight": 65.0,
        "implementation": "lambda: record_score(read_json(OUTPUT / 'policy_violations.json')['violations'], e['violations'], ['action_id', 'data_field_name'])"
      },
      {
        "name": "严重性汇总",
        "weight": 10.0,
        "implementation": "lambda: tree_score({k: v for k, v in read_json(OUTPUT / 'policy_violations.json').items() if k != 'violations'}, {'total_violations': len(e['violations']), 'severity_breakdown': e['severity']})"
      },
      {
        "name": "跨域放大率",
        "weight": 25.0,
        "implementation": "lambda: record_score(read_csv(OUTPUT / 'cross_domain_exposure_report.csv'), e['exposure'], ['domain'])"
      }
    ],
    "resultFiles": [
      {
        "path": "/logs/verifier/reward.txt",
        "description": "0～1 的最终得分。"
      },
      {
        "path": "/logs/verifier/score.json",
        "description": "各检查项的名称、权重、得分与错误原因。"
      }
    ],
    "failurePolicy": "缺少文件、解析失败或检查异常时，该检查项记 0 分，并在 score.json 中记录原因。"
  },
  "deliverables": [
    {
      "name": "policy_violations.json",
      "path": "output/policy_violations.json",
      "format": "JSON",
      "description": "字段级违规、政策条款、严重性与汇总。"
    },
    {
      "name": "cross_domain_exposure_report.csv",
      "path": "output/cross_domain_exposure_report.csv",
      "format": "CSV",
      "description": "各业务域的数据类型、智能体数量及暴露放大率。"
    }
  ],
  "referenceFileCount": 2,
  "runtime": {
    "framework": "Harbor",
    "configuration": "task.toml",
    "os": "Linux",
    "architecture": "linux/arm64、linux/amd64",
    "workspace": {
      "input": "/app/input",
      "software": "/app/software",
      "output": "/app/output"
    },
    "agentTimeoutSec": 3600.0,
    "verifierTimeoutSec": 1200.0,
    "verifierMode": "separate",
    "commands": [
      "python3 run.py check",
      "python3 run.py oracle",
      "python3 run.py nop"
    ],
    "services": []
  },
