  "evaluation": {
    "method": "评分器读取交付文件，逐项计算 0～1 的得分，再按权重求加权平均。网站以 100 分制展示结果。",
    "criteria": [
      {
        "name": "五因子序列",
        "weight": 90,
        "rule": "按月份比对全部五因子数值及月份集合，绝对容差为 0.00001，按正确比例计分。"
      },
      {
        "name": "样本审计",
        "weight": 10,
        "rule": "按月份比对合格样本数与迟到披露剔除数，按正确比例计分。"
      }
    ],
    "notes": "",
    "scoreRange": [
      0,
      100
    ],
    "type": "deterministic",
    "entrypoint": "tests/test.sh",
    "verifierMode": "separate",
    "formula": "reward = Σ(weight × check_score) / Σ(weight)；网站得分 = 100 × reward",
    "process": [
      "按月份读取五因子结果，核对 134 个月的集合和唯一性。",
      "逐月逐因子比较市场、规模、价值、盈利与投资结果。",
      "核对时点筛选审计中的股票池与会计信息使用窗口。"
    ],
    "metrics": [
      "因子数值占 90%，时点审计占 10%。",
      "因子数值绝对容差 1e−5，rtol=0；月份按 date 主键比较。"
    ],
    "gates": [],
