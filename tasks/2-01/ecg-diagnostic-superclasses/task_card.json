  "evaluation": {
    "method": "评分器读取交付文件，逐项计算 0～1 的得分，再按权重求加权平均。网站以 100 分制展示结果。",
    "criteria": [
      {
        "name": "分类效果",
        "weight": 98,
        "rule": "按测试 ID 对齐预测与参考标签，计算宏平均 F1；本项得分为 98 × min(1, F1 ÷ 0.75)。"
      },
      {
        "name": "方法说明",
        "weight": 2,
        "rule": "读取方法报告，正文超过 60 个字符取得本项分数。"
      }
    ],
    "notes": "预测文件需完整覆盖测试 ID，每个 ID 唯一，标签列取值为 0 或 1。",
    "scoreRange": [
      0,
      100
    ],
    "type": "deterministic",
    "entrypoint": "tests/test.sh",
    "verifierMode": "separate",
    "formula": "reward = Σ(weight × check_score) / Σ(weight)；网站得分 = 100 × reward",
    "process": [
      "读取 predictions.csv，验证独立测试集 ECG ID、唯一性与 NORM、MI、STTC、CD、HYP 五个标签列。",
      "将逐记录标签与评分集对齐，计算五类 macro-F1。",
      "记录 classification_metrics.json，并检查模型说明。"
    ],
    "metrics": [
      "分类得分 = min(1, macro-F1 / 0.75)，占 98%；说明项占 2%。",
      "各类别 F1 等权平均，zero_division=0；模型说明须超过 60 个字符。"
    ],
    "gates": [
      "ECG ID 集合、唯一性、列名和 0/1 标签格式共同决定分类项是否可评分。"
    ],
    "checks": [
      {
        "name": "独立测试macro-F1",
        "weight": 98.0,
        "implementation": "score"
      },
      {
        "name": "方法与限制说明",
        "weight": 2.0,
        "implementation": "lambda: len((OUTPUT / 'model_report.md').read_text()) > 60"
      }
    ],
    "resultFiles": [
      {
        "path": "/logs/verifier/reward.txt",
