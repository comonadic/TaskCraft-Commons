  "evaluation": {
    "method": "评分器读取交付文件，逐项计算 0～1 的得分，再按权重求加权平均。网站以 100 分制展示结果。",
    "criteria": [
      {
        "name": "预测表现",
        "weight": 90,
        "rule": "分别计算相对朴素基线的 WIS 与 MAE 改进率，两者按 70% 和 30% 加权；改进率除以 35% 并截在 0～1 后计分。"
      },
      {
        "name": "结果复现",
        "weight": 10,
        "rule": "重新执行预测程序，将生成结果与提交表逐记录比较；方法说明至少 30 个字符。"
      }
    ],
    "notes": "预测表覆盖全部 212 个目标，区间与点预测满足 0 ≤ 下界 ≤ 点预测 ≤ 上界。",
