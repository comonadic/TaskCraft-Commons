    ],
    "type": "deterministic",
    "entrypoint": "tests/test.sh",
    "verifierMode": "separate",
    "formula": "reward = Σ(weight × check_score) / Σ(weight)；网站得分 = 100 × reward",
    "process": [
      "读取完整地点、周次与分位数预测，检查概率顺序和结果结构。",
      "用评分期真实值重算 WIS 与 MAE，并与 naive 基线比较。",
      "在新工作目录复跑提交代码，比较重新生成的预测。"
    ],
    "metrics": [
      "技能得分 = 0.7 × clip((1−WIS/基线WIS)/0.35,0,1) + 0.3 × clip((1−MAE/基线MAE)/0.35,0,1)。",
      "预测技能占 90%，代码复跑一致性占 10%。",
      "每份预测须恰好包含 212 个唯一地点与周次组合；区间须满足 0 ≤ lower95 ≤ point ≤ upper95。"
    ],
