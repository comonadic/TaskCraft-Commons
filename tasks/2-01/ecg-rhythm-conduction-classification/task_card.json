  "evaluation": {
    "method": "评分器读取交付文件，逐项计算 0～1 的得分，再按权重求加权平均。网站以 100 分制展示结果。",
    "criteria": [
      {
        "name": "分类效果",
        "weight": 98,
        "rule": "按测试 ID 对齐预测与参考标签，计算宏平均 F1；本项得分为 98 × min(1, F1 ÷ 0.75)。"
      },
      {
        "name": "方法说明",
        "weight": 2,
        "rule": "读取方法报告，正文超过 60 个字符取得本项分数。"
      }
    ],
    "notes": "预测文件需完整覆盖测试 ID，每个 ID 唯一，标签列取值为 0 或 1。",
    "scoreRange": [
      0,
      100
    ],
    "type": "deterministic",
    "entrypoint": "tests/test.sh",
    "verifierMode": "separate",
    "formula": "reward = Σ(weight × check_score) / Σ(weight)；网站得分 = 100 × reward",
    "process": [
      "读取 predictions.csv，验证独立测试集 ECG ID、唯一性、列名和 0/1 标签。",
      "逐类别计算 F1，然后计算 macro-F1。",
      "保存 classification_metrics.json，读取模型方法与限制说明。"
    ],
    "metrics": [
      "分类得分 = min(1, macro-F1 / 0.75)。总分 = 98 × 分类得分 + 2 × 说明合格指示值。",
      "macro-F1 对各类别等权平均；零分母的类别 F1 为 0。",
      "model_report.md 超过 60 个字符取得说明项分数。"
    ],
    "gates": [
      "预测 ID 集合必须与独立测试集完全一致，且每个 ID 恰好出现一次；标签须为 0 或 1。"
    ],
    "checks": [
      {
        "name": "独立测试macro-F1",
        "weight": 98.0,
        "implementation": "score"
      },
      {
        "name": "方法与限制说明",
        "weight": 2.0,
        "implementation": "lambda: len((OUTPUT / 'model_report.md').read_text()) > 60"
      }
    ],
    "resultFiles": [
