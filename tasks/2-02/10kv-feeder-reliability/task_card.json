      "bytes": 8436,
      "description": "topology.svg，用于10kV 馈线双口径可靠性分析。"
    },
    {
      "name": "transformers.csv",
      "path": "environment/input/transformers.csv",
      "format": "CSV",
      "bytes": 1360,
      "description": "transformers.csv，用于10kV 馈线双口径可靠性分析。"
    }
  ],
  "inputFileCount": 4,
  "inputManifest": "materials.json",
  "referenceFiles": [
    {
      "name": "cn_reliability_report.json",
