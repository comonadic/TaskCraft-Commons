      "bytes": 185,
      "description": "用户加权口径指标及用户总数。"
    },
    {
      "name": "loadpoint_metrics.csv",
      "path": "reference/loadpoint_metrics.csv",
      "format": "CSV",
      "bytes": 3291,
      "description": "逐变压器故障率、停电时长、用户数与负荷。"
    },
    {
      "name": "method.md",
      "path": "reference/method.md",
      "format": "MD",
      "bytes": 249,
