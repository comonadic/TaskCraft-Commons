      "bytes": 10636,
      "description": "feeder_cim.xml，用于10kV 馈线双口径可靠性分析。"
    },
    {
      "name": "业务规则说明",
      "path": "environment/input/rules.md",
      "format": "MD",
      "bytes": 728,
      "description": "业务规则说明，用于10kV 馈线双口径可靠性分析。"
    },
    {
      "name": "topology.svg",
      "path": "environment/input/topology.svg",
